# EmailJS credentials for the order form (components/OrderForm.tsx).
# Sends directly from the browser — no backend needed, works on GitHub Pages.
# Without these set, the form gracefully falls back to opening the
# visitor's own mail client (mailto:) instead of erroring out.
#
# Setup:
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (e.g. Gmail) — copy its Service ID
# 3. Create an Email Template with variables: from_name, reply_to,
#    project_type, budget, message, lang — copy its Template ID
# 4. Account > General > Public Key — copy it
# 5. Account > Security > add your production domain (e.g. azen-dev.github.io)
#    to the allowlist so the public key can't be used from other sites
#
# These are NEXT_PUBLIC_ vars: they get baked into the static build and are
# visible in the browser. That's expected for EmailJS — the public key is
# designed to be public, and the domain allowlist in step 5 is what protects it.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
